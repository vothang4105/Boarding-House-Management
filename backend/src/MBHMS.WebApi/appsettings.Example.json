{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mbhms_db;Username=postgres;Password=postgres",
    "SupabaseConnection": "Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project-ref;Password=your-db-password"
  },
  "Supabase": {
    "Url": "https://your-project-ref.supabase.co",
    "AnonKey": "YOUR_SUPABASE_ANON_KEY",
    "ServiceRoleKey": "YOUR_SUPABASE_SERVICE_ROLE_KEY",
    "Storage": {
      "PublicRoomsBucket": "public-rooms",
      "PrivateDocumentsBucket": "private-documents",
      "SignedUrlExpirySeconds": 3600
    }
  },
  "SePay": {
    "ApiKey": "YOUR_SEPAY_API_KEY",
    "WebhookSecret": "YOUR_SEPAY_WEBHOOK_SECRET",
    "AccountNumber": "0987654321",
    "BankCode": "MBBank",
    "QrBaseUrl": "https://qr.sepay.vn/img",
    "QrTemplate": "compact"
  },
  "Email": {
    "Provider": "Resend",
    "FromEmail": "notifications@yourdomain.com",
    "FromName": "MBHMS Hệ Thống Nhà Trọ",
    "Resend": {
      "ApiKey": "re_YOUR_RESEND_API_KEY"
    },
    "Mailtrap": {
      "Host": "sandbox.smtp.mailtrap.io",
      "Port": 2525,
      "Username": "YOUR_MAILTRAP_USERNAME",
      "Password": "YOUR_MAILTRAP_PASSWORD"
    }
  },
  "Jwt": {
    "Secret": "super_secret_jwt_key_at_least_32_characters_long_for_security_compliance",
    "Issuer": "MBHMS.WebApi",
    "Audience": "MBHMS.Client",
    "ExpiryMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  }
}
