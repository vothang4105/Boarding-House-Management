# ==============================================================================
# MINI BOARDING HOUSE MANAGEMENT SYSTEM (MBHMS) - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER COMMIT .env OR REAL CREDENTIALS TO GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# SYSTEM & TIMEZONE (NFR-13)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
TZ=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local Docker PostgreSQL:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mbhms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=Host=localhost;Port=5432;Database=mbhms_db;Username=postgres;Password=postgres

# Supabase Cloud PostgreSQL (Singapore Region - ap-southeast-1):
# Connection Pooling mode (Session or Transaction):
# SUPABASE_DB_URL=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project-ref;Password=your-db-password

# ------------------------------------------------------------------------------
# SUPABASE CLOUD & OBJECT STORAGE (NFR-06, NFR-10)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
SUPABASE_PUBLIC_ROOMS_BUCKET=public-rooms
SUPABASE_PRIVATE_DOCUMENTS_BUCKET=private-documents
SUPABASE_SIGNED_URL_EXPIRY_SECONDS=3600

# ------------------------------------------------------------------------------
# SEPAY PAYMENT GATEWAY & VIETQR (CR-01, FR-25, FR-26)
# ------------------------------------------------------------------------------
# SePay API Key obtained from my.sepay.vn (Test Mode or Production)
SEPAY_API_KEY=YOUR_SEPAY_API_KEY_HERE
# Secret key configured in SePay Webhook settings to verify authenticity
SEPAY_WEBHOOK_SECRET=YOUR_SEPAY_WEBHOOK_SECRET_KEY
# Bank Account details of Owner (Chị Lan)
SEPAY_ACCOUNT_NUMBER=0987654321
# Bank Identifier Code (e.g. MBBank, VCB, ICB, ACB, TCB)
SEPAY_BANK_CODE=MBBank
# Base URL for dynamic QR image generation
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL SERVICE (FR-24, FR-37, FR-44, FR-46)
# ------------------------------------------------------------------------------
# Email Provider Option: "Resend" or "Mailtrap"
EMAIL_PROVIDER=Resend

# Resend API (Recommended for live email delivery in demo):
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
EMAIL_FROM_ADDRESS=notifications@yourdomain.com
EMAIL_FROM_NAME=MBHMS Nhà Trọ Chị Lan

# Mailtrap SMTP (Recommended for test environment & bulk cronjobs):
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your_mailtrap_user
MAILTRAP_SMTP_PASSWORD=your_mailtrap_password

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION & SECURITY (NFR-04, NFR-05)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_compliance
JWT_ISSUER=MBHMS.WebApi
JWT_AUDIENCE=MBHMS.Client
JWT_EXPIRY_MINUTES=1440

# ------------------------------------------------------------------------------
# CLIENT APP URL (CORS Configuration)
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000
